# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# local upload/cache artifacts
/.tmp.driveupload/

# production
/build

# misc
.DS_Store
*.pem
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Playwright MCP trace/snapshot artifacts -- accessibility snapshots can
# capture field values verbatim (e.g. a password typed during a live test),
# so these must never be eligible for a broad `git add`.
.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts
