NEXT_PUBLIC_SITE_URL=http://localhost:4747

# Leave unset (or "self_hosted") if you're running this repo yourself --
# CreativeWriter's full writing desk works the same either way. Set to
# "managed_saas" only for a managed hosted deployment: that additionally
# turns on CreativeWriter's collaboration panels (reader comment triage,
# contributor suggestion/assignment review) as a companion capability.
# There's no per-user entitlement system yet, so this is deployment-wide.
# See src/lib/creativewriter-ui/access.ts.
NEXT_PUBLIC_DEPLOYMENT_MODE=self_hosted

# Resend (https://resend.com) — leave blank to skip email, invite URL still shown in UI
RESEND_API_KEY=
# Optional: defaults to BookForge <onboarding@resend.dev> (works without domain verification)
RESEND_FROM=

# Supabase local values come from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bearer token required by /api/internal/* cron-triggered routes (account purge
# flagging, collaboration email retries, CreativeWriter assignment reminders).
# Vercel Cron sends this automatically when the same value is set as a Vercel
# project env var -- see vercel.json for the schedule.
CRON_SECRET=

# LM Studio defaults.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio

# Cloud LLM providers — only needed if a user selects one under Settings > Cloud
# provider, or LLM_PROVIDER below is set. See src/lib/ai/providers.ts.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# OpenRouter — one key, many backends (https://openrouter.ai/keys). See
# docs/openrouter-integration-plan.md for the recommended default models.
OPENROUTER_API_KEY=
# Optional: sent as the HTTP-Referer header on OpenRouter requests (shows up
# in OpenRouter's usage dashboard/rankings). Defaults to https://bookforge.app.
OPENROUTER_APP_URL=

# Optional: force a specific cloud provider/model without a per-user DB row
# (see getStandardLlmSettingsFromEnv in src/lib/ai/providers.ts). Leave unset
# to use LM Studio / per-user settings instead.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TEMPERATURE=
LLM_MAX_OUTPUT_TOKENS=
